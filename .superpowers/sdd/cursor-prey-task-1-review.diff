diff --git a/Sources/DesktopPetCore/CursorInteractionPolicy.swift b/Sources/DesktopPetCore/CursorInteractionPolicy.swift
new file mode 100644
index 0000000..cd75a8d
--- /dev/null
+++ b/Sources/DesktopPetCore/CursorInteractionPolicy.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+public enum CursorInteractionPolicy {
+    public static let minimumPreyDisplaySize = 16.0
+    public static let maximumPreyDisplaySize = 128.0
+    public static let defaultPreyDisplaySize = 48.0
+
+    public static func clampedPreyDisplaySize(_ size: Double) -> Double {
+        min(max(size, minimumPreyDisplaySize), maximumPreyDisplaySize)
+    }
+
+    public static func isInteractionEligible(
+        isAutonomous: Bool,
+        landingMode: TeleportLandingMode,
+        hasPreyCandidate: Bool,
+        hasInteractionCandidate: Bool
+    ) -> Bool {
+        isAutonomous
+            && landingMode == .cursorNudge
+            && hasPreyCandidate
+            && hasInteractionCandidate
+    }
+}
diff --git a/Tests/DesktopPetTests/CursorInteractionPolicyTests.swift b/Tests/DesktopPetTests/CursorInteractionPolicyTests.swift
new file mode 100644
index 0000000..c0f8fe4
--- /dev/null
+++ b/Tests/DesktopPetTests/CursorInteractionPolicyTests.swift
@@ -0,0 +1,53 @@
+import XCTest
+@testable import DesktopPetCore
+
+final class CursorInteractionPolicyTests: XCTestCase {
+    func testPreySizeBoundsAreInclusive() {
+        XCTAssertEqual(CursorInteractionPolicy.minimumPreyDisplaySize, 16)
+        XCTAssertEqual(CursorInteractionPolicy.maximumPreyDisplaySize, 128)
+        XCTAssertEqual(CursorInteractionPolicy.clampedPreyDisplaySize(16), 16)
+        XCTAssertEqual(CursorInteractionPolicy.clampedPreyDisplaySize(128), 128)
+    }
+
+    func testPreySizeIsClampedToSupportedRange() {
+        XCTAssertEqual(CursorInteractionPolicy.clampedPreyDisplaySize(-10), 16)
+        XCTAssertEqual(CursorInteractionPolicy.clampedPreyDisplaySize(200), 128)
+    }
+
+    func testDefaultPreySizeIs48Points() {
+        XCTAssertEqual(CursorInteractionPolicy.defaultPreyDisplaySize, 48)
+    }
+
+    func testInteractionRequiresAutonomousCursorNudgeAndBothCandidates() {
+        XCTAssertTrue(CursorInteractionPolicy.isInteractionEligible(
+            isAutonomous: true,
+            landingMode: .cursorNudge,
+            hasPreyCandidate: true,
+            hasInteractionCandidate: true
+        ))
+        XCTAssertFalse(CursorInteractionPolicy.isInteractionEligible(
+            isAutonomous: false,
+            landingMode: .cursorNudge,
+            hasPreyCandidate: true,
+            hasInteractionCandidate: true
+        ))
+        XCTAssertFalse(CursorInteractionPolicy.isInteractionEligible(
+            isAutonomous: true,
+            landingMode: .corner,
+            hasPreyCandidate: true,
+            hasInteractionCandidate: true
+        ))
+        XCTAssertFalse(CursorInteractionPolicy.isInteractionEligible(
+            isAutonomous: true,
+            landingMode: .cursorNudge,
+            hasPreyCandidate: false,
+            hasInteractionCandidate: true
+        ))
+        XCTAssertFalse(CursorInteractionPolicy.isInteractionEligible(
+            isAutonomous: true,
+            landingMode: .cursorNudge,
+            hasPreyCandidate: true,
+            hasInteractionCandidate: false
+        ))
+    }
+}

