diff --git a/Sources/DesktopPetCore/OneShotPlaybackState.swift b/Sources/DesktopPetCore/OneShotPlaybackState.swift
new file mode 100644
index 0000000..1962b1e
--- /dev/null
+++ b/Sources/DesktopPetCore/OneShotPlaybackState.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+/// Pure state for a special clip that must play once before ordinary playback resumes.
+public struct OneShotPlaybackState: Equatable {
+    public enum Resolution: Equatable {
+        case play(String)
+        case stop
+    }
+
+    public private(set) var interactionID: String?
+    public private(set) var preferredReturnID: String?
+
+    public var isActive: Bool {
+        interactionID != nil
+    }
+
+    public init() {}
+
+    public mutating func start(interactionID: String, preferredReturnID: String?) {
+        self.interactionID = interactionID
+        self.preferredReturnID = preferredReturnID
+    }
+
+    public mutating func cancel() {
+        interactionID = nil
+        preferredReturnID = nil
+    }
+
+    /// Resolves an active one-shot exactly once against the current ordinary playlist.
+    public mutating func finish(availableOrdinaryIDs: [String]) -> Resolution? {
+        guard isActive else { return nil }
+        let preferredReturnID = preferredReturnID
+        cancel()
+
+        if let preferredReturnID, availableOrdinaryIDs.contains(preferredReturnID) {
+            return .play(preferredReturnID)
+        }
+        if let fallbackID = availableOrdinaryIDs.first {
+            return .play(fallbackID)
+        }
+        return .stop
+    }
+}
diff --git a/Tests/DesktopPetTests/OneShotPlaybackStateTests.swift b/Tests/DesktopPetTests/OneShotPlaybackStateTests.swift
new file mode 100644
index 0000000..8d1cfee
--- /dev/null
+++ b/Tests/DesktopPetTests/OneShotPlaybackStateTests.swift
@@ -0,0 +1,53 @@
+import XCTest
+@testable import DesktopPetCore
+
+final class OneShotPlaybackStateTests: XCTestCase {
+    func testStartCapturesPreferredOrdinaryReturnID() {
+        var state = OneShotPlaybackState()
+
+        state.start(interactionID: "interaction", preferredReturnID: "ordinary")
+
+        XCTAssertTrue(state.isActive)
+        XCTAssertEqual(state.interactionID, "interaction")
+        XCTAssertEqual(state.preferredReturnID, "ordinary")
+    }
+
+    func testFinishReturnsCapturedOrdinaryClipAndIsHarmlessWhenRepeated() {
+        var state = OneShotPlaybackState()
+        state.start(interactionID: "interaction", preferredReturnID: "ordinary")
+
+        XCTAssertEqual(
+            state.finish(availableOrdinaryIDs: ["fallback", "ordinary"]),
+            .play("ordinary")
+        )
+        XCTAssertFalse(state.isActive)
+        XCTAssertNil(state.finish(availableOrdinaryIDs: ["fallback", "ordinary"]))
+    }
+
+    func testCancelClearsActiveOneShotWithoutACompletion() {
+        var state = OneShotPlaybackState()
+        state.start(interactionID: "interaction", preferredReturnID: "ordinary")
+
+        state.cancel()
+
+        XCTAssertFalse(state.isActive)
+        XCTAssertNil(state.finish(availableOrdinaryIDs: ["ordinary"]))
+    }
+
+    func testFinishFallsBackToFirstAvailableOrdinaryClipWhenPreferredReturnIsInvalid() {
+        var state = OneShotPlaybackState()
+        state.start(interactionID: "interaction", preferredReturnID: "removed")
+
+        XCTAssertEqual(
+            state.finish(availableOrdinaryIDs: ["fallback", "another"]),
+            .play("fallback")
+        )
+    }
+
+    func testFinishStopsWhenNoOrdinaryFallbackExists() {
+        var state = OneShotPlaybackState()
+        state.start(interactionID: "interaction", preferredReturnID: "removed")
+
+        XCTAssertEqual(state.finish(availableOrdinaryIDs: []), .stop)
+    }
+}

