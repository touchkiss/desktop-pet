index 0000000..d0b7bdc
--- /dev/null
+++ b/Sources/DesktopPetCore/CursorInteractionSessionState.swift
@@ -0,0 +1,66 @@
+import Foundation
+
+/// Pure lifecycle state for one paired cursor-prey interaction.
+public struct CursorInteractionSessionState: Equatable {
+    public enum Phase: Equatable {
+        case idle
+        case pending
+        case active
+    }
+
+    public enum Cleanup: Equatable {
+        case pending
+        case active
+    }
+
+    public private(set) var phase: Phase = .idle
+    public private(set) var preyID: String?
+    public private(set) var interactionID: String?
+
+    public init() {}
+
+    /// Saves one distinct pair without replacing an existing session.
+    @discardableResult
+    public mutating func prepare(preyID: String, interactionID: String) -> Bool {
+        guard phase == .idle,
+              preyID != interactionID else {
+            return false
+        }
+
+        self.preyID = preyID
+        self.interactionID = interactionID
+        phase = .pending
+        return true
+    }
+
+    /// Marks a prepared pair active exactly once.
+    @discardableResult
+    public mutating func activate() -> Bool {
+        guard phase == .pending,
+              preyID != nil,
+              interactionID != nil else {
+            return false
+        }
+        phase = .active
+        return true
+    }
+
+    /// Clears the session and reports its former phase exactly once.
+    @discardableResult
+    public mutating func clear() -> Cleanup? {
+        let cleanup: Cleanup
+        switch phase {
+        case .idle:
+            return nil
+        case .pending:
+            cleanup = .pending
+        case .active:
+            cleanup = .active
+        }
+
+        phase = .idle
+        preyID = nil
+        interactionID = nil
+        return cleanup
+    }
+}
diff --git a/Tests/DesktopPetTests/CursorInteractionSessionStateTests.swift b/Tests/DesktopPetTests/CursorInteractionSessionStateTests.swift
